<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_contracting" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.contracting.invoice</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="inside">
                <setting id="contracting_invoice_default_setting" string="Construction Invoices"
                         help="Open new customer invoices as Construction invoices (Work Done % billing). Turn off to start them as Labour Supply invoices.">
                    <field name="contracting_invoice_default"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
