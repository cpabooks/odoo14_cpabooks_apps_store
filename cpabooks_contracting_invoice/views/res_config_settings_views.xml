<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_contracting" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.contracting.invoice</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='invoicing_settings']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="contracting_invoice_default_setting">
                    <div class="o_setting_left_pane">
                        <field name="contracting_invoice_default"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="contracting_invoice_default" string="Construction Invoices"/>
                        <div class="text-muted">
                            Open new customer invoices as Construction invoices (Work Done % billing).
                            Turn off to start them as Labour Supply invoices.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
