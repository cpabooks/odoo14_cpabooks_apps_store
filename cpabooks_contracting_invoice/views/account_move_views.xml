<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_contracting" model="ir.ui.view">
        <field name="name">account.move.form.contracting.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Header buttons -->
            <xpath expr="//header" position="inside">
                <button name="action_print_contracting_invoice" type="object"
                        string="Print Contracting Invoice"
                        attrs="{'invisible': ['|', ('is_construction_invoice', '=', False), ('move_type', 'not in', ('out_invoice', 'out_refund'))]}"/>
                <button name="action_contracting_next_claim" type="object"
                        string="Next Progress Claim"
                        attrs="{'invisible': ['|', '|', ('is_construction_invoice', '=', False), ('state', '!=', 'posted'), ('move_type', '!=', 'out_invoice')]}"
                        help="Copy this invoice for the next claim. Work Done % moves into Previous %."/>
            </xpath>

            <!-- Switch (also driven by the control panel toggle) -->
            <xpath expr="//group[@name='sale_info_group']" position="inside">
                <field name="is_construction_invoice"
                       attrs="{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund'))], 'readonly': [('state', '!=', 'draft')]}"/>
            </xpath>

            <!-- Invoice lines: list -->
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='discount']" position="attributes">
                <attribute name="attrs">{'column_invisible': [('parent.is_construction_invoice', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='discount']" position="after">
                <field name="contract_discount" optional="hide"
                       attrs="{'column_invisible': [('parent.is_construction_invoice', '=', False)]}"/>
                <field name="contract_amount" optional="show"
                       attrs="{'column_invisible': [('parent.is_construction_invoice', '=', False)]}"/>
                <field name="contract_previous_pct" optional="show"
                       attrs="{'column_invisible': [('parent.is_construction_invoice', '=', False)]}"/>
                <field name="contract_work_done_pct"
                       attrs="{'column_invisible': [('parent.is_construction_invoice', '=', False)]}"/>
                <field name="contract_guaranteed" optional="hide"
                       attrs="{'column_invisible': [('parent.is_construction_invoice', '=', False)]}"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']" position="after">
                <field name="contract_tax_amount" optional="show"
                       attrs="{'column_invisible': [('parent.is_construction_invoice', '=', False)]}"/>
            </xpath>

            <!-- Invoice lines: form (mobile / line popup) -->
            <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='price_unit']" position="after">
                <field name="contract_discount" attrs="{'invisible': [('parent.is_construction_invoice', '=', False)]}"/>
                <field name="contract_previous_pct" attrs="{'invisible': [('parent.is_construction_invoice', '=', False)]}"/>
                <field name="contract_work_done_pct" attrs="{'invisible': [('parent.is_construction_invoice', '=', False)]}"/>
                <field name="contract_guaranteed" attrs="{'invisible': [('parent.is_construction_invoice', '=', False)]}"/>
            </xpath>

            <!-- Journal items: Odoo saves invoice lines through line_ids, so the
                 contracting values must be present there as well. -->
            <xpath expr="//field[@name='line_ids']/tree/field[@name='account_id']" position="after">
                <field name="contract_discount" invisible="1"/>
                <field name="contract_previous_pct" invisible="1"/>
                <field name="contract_work_done_pct" invisible="1"/>
                <field name="contract_guaranteed" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
