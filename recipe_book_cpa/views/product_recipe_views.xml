<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_recipe" model="ir.ui.view">
        <field name="name">product.template.form.recipe</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="priority" eval="110"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Recipe" name="cpabooks_recipe_page">
                    <field name="recipe_id" invisible="1"/>
                    <group attrs="{'invisible': [('recipe_id', '=', False)]}">
                        <group>
                            <field name="recipe_id" readonly="1" options="{'no_create': True}"/>
                            <field name="recipe_category"/>
                        </group>
                        <group>
                            <field name="recipe_menu_price"/>
                            <field name="recipe_food_cost"/>
                            <field name="recipe_cost_pct"/>
                        </group>
                    </group>
                    <field name="recipe_line_ids" nolabel="1" attrs="{'invisible': [('recipe_id', '=', False)]}"
                           context="{'default_recipe_id': recipe_id}">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"/>
                            <field name="budget_qty"/>
                            <field name="budget_uom"/>
                            <field name="budget_unit_cost"/>
                            <field name="budget_line_cost"/>
                            <field name="qty"/>
                            <field name="uom_id"/>
                            <field name="unit_cost"/>
                            <field name="line_cost"/>
                            <field name="link_note"/>
                        </tree>
                    </field>
                    <button name="action_add_recipe" type="object" string="Add recipe"
                            class="btn-primary" attrs="{'invisible': [('recipe_id', '!=', False)]}"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
