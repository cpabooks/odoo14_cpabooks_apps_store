<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cpabooks_coa_default_pdc_settings" model="ir.ui.view">
        <field name="name">cpabooks.coa.default.pdc.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="priority">45</field>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Set by Default" name="cpabooks_default_ledgers">
                    <setting string="PDC Customer">
                        <field name="pdc_customer"
                               domain="[('company_ids', 'in', company_id)]"
                               options="{'no_create': True}"/>
                    </setting>
                    <setting string="PDC Vendor">
                        <field name="pdc_vendor"
                               domain="[('company_ids', 'in', company_id)]"
                               options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
