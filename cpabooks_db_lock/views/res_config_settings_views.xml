<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_db_lock" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.db.lock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='user_default_rights']" position="inside">
                <setting id="db_manager_lock_setting"
                         help="Hide Manage Databases and the database selector on the login page, and block create, duplicate, drop, backup and restore. Unlock only while you take a backup.">
                    <field name="db_manager_locked"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
