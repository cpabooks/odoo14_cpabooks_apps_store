<odoo>
<record id="dashboard_kanban" model="ir.ui.view">
    <field name="name">recipe.dashboard.kanban</field>
    <field name="model">cpabooks.recipe</field>
    <field name="arch" type="xml">
        <kanban class="o_recipe_menu_kanban">
            <field name="id"/>
            <field name="name"/>
            <field name="code"/>
            <field name="image_1920"/>
            <field name="menu_price"/>
            <field name="budget_cost"/>
            <field name="category"/>
            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_global_click o_recipe_menu_card">
                        <div class="o_recipe_menu_photo">
                            <img t-if="record.image_1920.raw_value" t-att-src="kanban_image('cpabooks.recipe','image_1920',record.id.raw_value)" t-att-alt="record.name.value"/>
                        </div>
                        <div class="o_recipe_menu_body">
                            <strong><field name="name"/></strong>
                            <div class="o_recipe_menu_price">
                                <t t-if="record.menu_price.raw_value"><field name="menu_price"/> AED</t>
                                <t t-else=""><field name="budget_cost"/></t>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>
<record id="action_recipe_status_dashboard" model="ir.actions.client">
    <field name="name">Restaurant Status</field>
    <field name="tag">cpabooks_recipe_dashboard</field>
</record>
</odoo>
