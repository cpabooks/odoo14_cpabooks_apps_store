<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_fsm_project_task_form_material_return" model="ir.ui.view">
            <field name="name">view.fsm.project.task.form.material.return</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/notebook" position="inside">
                    <page string="Material Return" invisible="not fsm_crn_form">
                        <button name="action_view_material_returns"
                                type="object"
                                string="Open Material Returns"
                                class="oe_highlight"/>
                        <group>
                            <field name="material_return_move_ids" nolabel="1" readonly="1">
                                <list string="Material Returns" create="0" edit="0" delete="0">
                                    <field name="product_id"/>
                                    <field name="description_picking" string="Description"/>
                                    <field name="product_uom_qty" string="Quantity"/>
                                    <field name="quantity" string="Done Quantity"/>
                                </list>
                            </field>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="action_material_return" model="ir.actions.act_window">
            <field name="name">Material Return</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('issue_project_task_id', '!=', False), ('is_material_return', '=', True)]</field>
            <field name="context">{'show_task_seq': True, 'show_crn_number': True}</field>
        </record>

        <menuitem id="menu_material_return"
                  name="Material Return"
                  parent="stock.menu_stock_warehouse_mgmt"
                  action="action_material_return"
                  sequence="10"/>
    </data>
</odoo>
