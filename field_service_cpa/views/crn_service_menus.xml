<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_crn_service_dashboard" model="ir.actions.client">
        <field name="name">Complaint Registration Management</field>
        <field name="tag">crn_service_dashboard</field>
    </record>

    <record id="action_crn_processing_cycle" model="ir.actions.client">
        <field name="name">CRN Processing Cycle</field>
        <field name="tag">crn_processing_cycle</field>
    </record>

    <record id="action_crn_service_work" model="ir.actions.client">
        <field name="name">Complaint Registration Management</field>
        <field name="tag">crn_service_dashboard</field>
    </record>

    <menuitem id="menu_fsm_root" name="Field Service" sequence="-90"
              web_icon="field_service_cpa,static/description/icon.png"
              action="action_crn_service_dashboard"/>
    <menuitem id="menu_fsm_tasks" name="CRNs" parent="menu_fsm_root" sequence="10"/>
    <menuitem id="menu_fsm_reporting" name="Reporting" parent="menu_fsm_root" sequence="80"/>
    <menuitem id="menu_fsm_settings" name="Configuration" parent="menu_fsm_root" sequence="90" groups="field_service_cpa.group_fsm_manager"/>
    <!-- Under standard Odoo Field Service app (name unchanged in app switcher). -->
    <menuitem
        id="menu_crn_service_dashboard"
        name="Dashboard"
        parent="field_service_cpa.menu_fsm_root"
        action="action_crn_service_dashboard"
        sequence="1"/>

    <menuitem
        id="menu_crn_processing_cycle"
        name="CRN Processing Cycle"
        parent="field_service_cpa.menu_fsm_root"
        action="action_crn_processing_cycle"
        sequence="2"/>

</odoo>
