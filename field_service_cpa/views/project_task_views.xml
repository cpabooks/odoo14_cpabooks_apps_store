<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <!-- Legacy compat view removed: duplicated xpaths on industry_fsm and broke upgrade
             when cpabooks_approval views reference approval_state before that module loads. -->
        <function model="ir.ui.view" name="cpabooks_unlink_views_by_xmlid">
            <value eval="['view_fsm_project_task_form_view_inherit_project']"/>
        </function>

        <record id="fsm_project_task_tree_inherit" model="ir.ui.view">
            <field name="name">fsm.project.task.tree.inherit</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_tree2"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <attribute name="default_order">write_date desc, create_date desc, id desc</attribute>
                </xpath>
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="optional">show</attribute>
                </xpath>
                <xpath expr="//field[@name='name']" position="before">
                    <field name="write_date" invisible="1"/>
                    <field name="create_date" string="Create Date" widget="date"
                           invisible="not context.get('fsm_mode', False)"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="task_seq" string="CRN No" invisible="not context.get('fsm_mode', False)"/>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="complaint_details_short" string="Details"
                           class="o_crn_complaint_details_list"
                           invisible="not context.get('fsm_mode', False)" optional="show"/>
                    <field name="client_person" invisible="not context.get('fsm_mode', False)" optional="hide"/>
                    <field name="client_contact" invisible="not context.get('fsm_mode', False)" optional="hide"/>
                    <field name="client_email" invisible="not context.get('fsm_mode', False)" optional="hide"/>
                    <field name="complaint_type" invisible="not context.get('fsm_mode', False)" optional="hide"/>
                    <field name="fsm_stage_group" string="CRN Stage" invisible="not context.get('fsm_mode', False)"/>
                    <field name="fsm_stage_progress" string="Progress %" widget="progressbar"
                           invisible="not context.get('fsm_mode', False)" optional="show"/>
                    <field name="age_days" invisible="not context.get('fsm_mode', False)"/>
                    <field name="material_cost_total" invisible="not context.get('fsm_mode', False)" optional="show"/>
                    <field name="timesheet_cost_total" invisible="not context.get('fsm_mode', False)" optional="show"/>
                    <field name="total_service_cost" invisible="not context.get('fsm_mode', False)" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="site_location" invisible="not context.get('fsm_mode', False)"/>
                </xpath>
                <xpath expr="//field[@name='company_id']" position="before">
                    <field name="approved_by" invisible="not context.get('fsm_mode', False)"/>
                </xpath>
            </field>
        </record>

        <!-- Remove stale extensions before parent reload (old approval xpaths break upgrade). -->
        <function model="ir.ui.view" name="cpabooks_unlink_views_by_xmlid">
            <value eval="[
                'view_fsm_crn_stage7_layout',
                'view_fsm_project_task_form_customer_parts',
                'view_fsm_project_task_form_material_return',
                'view_fsm_project_task_form_action_navigation_duplicate_fields',
                'view_fsm_project_task_form_workflow_ui',
                'view_fsm_task_employee_assignee_project_extend',
                'view_fsm_project_task_form_remove_duplicate_next_action',
            ]"/>
        </function>

        <record id="view_fsm_project_task_form_hide_project_extend_state" model="ir.ui.view">
            <field name="name">view.fsm.project.task.form.hide.project.extend.state</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='stage_id']/following-sibling::field[@name='state'][1]" position="attributes">
                    <attribute name="invisible">context.get('fsm_mode', False)</attribute>
                </xpath>
            </field>
        </record>

        <!-- Compatibility note:
             This customization expected a dashboard form view XML ID that is not present in the installed
             all_in_one_schedule_activity_management data. The inherited override is skipped to keep module upgrades working. -->

        <!-- TREE -->
        <record id="project_task_view_form_timesheet_cleanup" model="ir.ui.view">
            <field name="name">project.task.form.timesheet.cleanup</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="hr_timesheet.view_task_form2_inherited"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='planned_hours']" position="attributes">
                    <attribute name="invisible">context.get('fsm_mode', False)</attribute>
                </xpath>
                <xpath expr="//field[@name='subtask_planned_hours']" position="attributes">
                    <attribute name="invisible">context.get('fsm_mode', False)</attribute>
                </xpath>
            </field>
        </record>

        <record id="project_task_view_form_hide_mark_as_done" model="ir.ui.view">
            <field name="name">project.task.form.hide.mark.as.done</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="priority">300</field>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_fsm_validate']" position="replace"/>
            </field>
        </record>

        <record id="project_task_view_form_sale_timesheet_inherit" model="ir.ui.view">
            <field name="name">project.task.form.sale.timesheet.inherit</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="sale_timesheet.project_task_view_form_inherit_sale_timesheet"/>
            <field name="arch" type="xml">
                <!-- Only target nodes present on both old and new sale_timesheet arches.
                     remaining_hours_so / remaining_hours_so_label exist only after a
                     newer sale_timesheet view sync; xpath on them breaks upgrades. -->
                <xpath expr="//field[@name='timesheet_product_id']" position="attributes">
                    <attribute name="invisible">context.get('fsm_mode', False)</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_fsm_project_task_form_hide_timesheet_button" model="ir.ui.view">
            <field name="name">view.fsm.project.task.form.hide.timesheet.button</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="priority">300</field>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_view_timesheets']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <!-- Skipped: depends on all_in_one_schedule_activity_management.activity_task_form_inherit_dashboard,
             which is missing in the current database. -->

        <record id="view_fsm_project_task_form_hide_check_list_page" model="ir.ui.view">
            <field name="name">view.fsm.project.task.form.hide.check.list.page</field>
            <field name="model">project.task</field>
            <field name="inherit_id"
                   ref="all_in_one_schedule_activity_management.inherit_project_task_form_description_page"/>
            <field name="priority">300</field>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='description_lines_page']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_fsm_project_task_form_show_cost_summary" model="ir.ui.view">
            <field name="name">view.fsm.project.task.form.show.cost.summary</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="view_fsm_project_task_form_view_inherit"/>
            <field name="priority">350</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='tag_ids']" position="after">
                    <label for="material_cost_total" invisible="not context.get('fsm_mode', False)"/>
                    <div class="o_row" invisible="not context.get('fsm_mode', False)">
                        <field name="material_cost_total" string="Total Material Cost" readonly="1" nolabel="1"/>
                    </div>
                    <label for="timesheet_cost_total" invisible="not context.get('fsm_mode', False)"/>
                    <div class="o_row" invisible="not context.get('fsm_mode', False)">
                        <field name="timesheet_cost_total" readonly="1" nolabel="1"/>
                    </div>
                </xpath>
            </field>
        </record>

        <template id="assets_fsm_task_form" inherit_id="web.assets_backend" name="FSM Task Form assets">
            <xpath expr="." position="inside">
                <link rel="stylesheet" href="/field_service_cpa/static/src/css/fsm_task_form.css"/>
                <script type="text/javascript" src="/field_service_cpa/static/src/js/fsm_task_form.js"/>
            </xpath>
        </template>

    </data>
</odoo>
