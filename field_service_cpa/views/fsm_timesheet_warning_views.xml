<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fsm_task_hide_inactive_timesheet_warning" model="ir.ui.view">
        <field name="name">project.task.form.hide.inactive.timesheet.warning.fsm</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="hr_timesheet.view_task_form2_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='timesheet_error']" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="attrs">{'invisible': [(1, '=', 1)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
