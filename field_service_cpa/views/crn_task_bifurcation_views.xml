<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Regular project task: Create CRN (does not modify this task). -->
        <record id="view_project_task_form_create_crn_button" model="ir.ui.view">
            <field name="name">project.task.form.create.crn.button</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_create_crn_from_task"
                            type="object"
                            string="Create CRN"
                            class="btn-primary"
                            attrs="{'invisible': ['|', ('is_fsm', '=', True), ('task_seq', '=like', 'CRN%')]}"/>
                </xpath>
                <xpath expr="//sheet" position="before">
                    <field name="is_fsm" invisible="1"/>
                    <field name="source_task_id" invisible="1"/>
                </xpath>
            </field>
        </record>

        <!-- Activity form: Create CRN from linked task/project. -->
        <record id="mail_activity_view_form_create_crn_button" model="ir.ui.view">
            <field name="name">mail.activity.form.create.crn.button</field>
            <field name="model">mail.activity</field>
            <field name="inherit_id" ref="mail.mail_activity_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_create_crn"
                            type="object"
                            string="Create CRN"
                            class="btn-secondary"
                            attrs="{'invisible': [('state', '=', 'done')]}"/>
                </xpath>
            </field>
        </record>

        <!-- Project task (TID): hide contract/TID block on CRN records. -->
        <record id="view_project_task_form_hide_tid_on_crn" model="ir.ui.view">
            <field name="name">project.task.form.hide.tid.on.crn</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <field name="is_fsm" invisible="1"/>
                </xpath>
                <xpath expr="//div[@class='oe_title pr-0']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_id']/preceding-sibling::field[@name='task_seq']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='is_group']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='crm_id']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='amount']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='period']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='amount_monthly_value']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='amount_quarterly_value']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='amount_per_year']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_value']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='amount_paid']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='amount_due']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': ['|', ('fsm_crn_form', '=', True), ('project_id', '=', False)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='tag_ids']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='date_deadline']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='priority_id']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='frequency_id']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='remarks']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='last_action']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='date_start']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='date_end']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='aging_days']" position="attributes" optional="True">
                    <attribute name="attrs">{'invisible': [('is_fsm', '=', True)]}</attribute>
                </xpath>
            </field>
        </record>

        <!-- CRN form: show FSM blocks by is_fsm (not only fsm_mode context). -->
        <!-- Project → Tasks: never list Field Service CRNs (All CRNs menu owns them). -->
        <record id="action_project_tasks_non_fsm" model="ir.actions.act_window">
            <field name="name">Tasks</field>
            <field name="res_model">project.task</field>
            <field name="view_mode">tree,form,kanban,calendar,pivot,graph</field>
            <field name="domain">['&amp;', '&amp;', '|', ('project_id', '=', False), ('project_id.is_fsm', '=', False), ('check_fsm', '=', False), '!', ('task_seq', '=like', 'CRN%')]</field>
            <field name="context">{'search_default_my_tasks': 1}</field>
        </record>

    </data>
</odoo>
