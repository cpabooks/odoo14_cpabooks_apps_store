<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cpa_cancel_wizard_form" model="ir.ui.view">
        <field name="name">cpa.cancel.wizard.form</field>
        <field name="model">cpa.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel / Reset / Delete">
                <field name="res_model" invisible="1"/>
                <field name="res_ids" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <strong><field name="record_count" class="oe_inline"/></strong>
                    <field name="model_label" class="oe_inline"/> selected.
                    Posted entries are unposted and stock from done transfers is put back.
                    "Delete" cannot be undone.
                </div>
                <group>
                    <field name="operation" widget="radio"/>
                    <field name="payment_mode" widget="radio" invisible="res_model != 'account.move'"/>
                </group>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cpa_cancel_wizard_move" model="ir.actions.act_window">
        <field name="name">Cancel / Reset / Delete</field>
        <field name="res_model">cpa.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(6, 0, [ref('group_cpa_cancel_posted')])]"/>
    </record>

