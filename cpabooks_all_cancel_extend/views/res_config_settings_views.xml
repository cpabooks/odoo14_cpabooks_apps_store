<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_cpa_cancel" model="ir.ui.view">
        <field name="name">res.config.settings.form.cpa.cancel</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Cancel Posted Documents" id="cpa_cancel_settings">
                    <setting string="Invoice Cancel Mode"
                             help="What the &quot;Cancel Entry&quot; button does on a posted invoice or journal entry.">
                        <field name="cpa_invoice_cancel_mode" widget="radio"/>
                    </setting>
                    <setting string="Linked Payment Mode"
                             help="What happens to payments reconciled with the cancelled invoice.">
                        <field name="cpa_payment_cancel_mode" widget="radio"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
