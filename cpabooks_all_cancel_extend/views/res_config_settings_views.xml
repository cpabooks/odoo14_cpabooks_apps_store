<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_cpa_cancel" model="ir.ui.view">
        <field name="name">res.config.settings.form.cpa.cancel</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='invoicing_settings']" position="after">
                <h2>Cancel Posted Documents</h2>
                <div class="row mt16 o_settings_container" id="cpa_cancel_settings">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="cpa_invoice_cancel_mode"/>
                            <div class="text-muted">
                                What the "Cancel Entry" button does on a posted invoice or journal entry.
                            </div>
                            <field name="cpa_invoice_cancel_mode" widget="radio"/>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="cpa_payment_cancel_mode"/>
                            <div class="text-muted">
                                What happens to payments reconciled with the cancelled invoice.
                            </div>
                            <field name="cpa_payment_cancel_mode" widget="radio"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
