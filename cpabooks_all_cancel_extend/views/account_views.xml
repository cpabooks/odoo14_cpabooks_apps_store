<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_cpa_cancel" model="ir.ui.view">
        <field name="name">account.move.form.cpa.cancel</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_draft']" position="after">
                <button name="action_cpa_cancel" type="object" string="Cancel Entry"
                        groups="cpabooks_all_cancel_extend.group_cpa_cancel_posted"
                        invisible="state != 'posted'"
                        confirm="Cancel this posted entry? Linked payments follow the setting in Accounting &gt; Settings."/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_form_cpa_cancel" model="ir.ui.view">
        <field name="name">account.payment.form.cpa.cancel</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button name="action_cpa_cancel" type="object" string="Cancel Payment"
                        groups="cpabooks_all_cancel_extend.group_cpa_cancel_posted"
                        confirm="Cancel this posted payment?" invisible="state not in ('in_process', 'paid')"/>
            </xpath>
        </field>
    </record>
</odoo>
